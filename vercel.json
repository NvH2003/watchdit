{
  "framework": null,
  "buildCommand": "npx expo export -p web && node scripts/fix-vercel-client-assets.js",
  "outputDirectory": "dist/client",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5.1.8",
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/|favicon\\.ico|favicon\\.png|sw\\.js|manifest\\.json|pwa-).*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/expo-static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
