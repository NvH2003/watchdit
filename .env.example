EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
# TheTVDB project key. Used when Netflix in NL/BE has its own episode order.
# Optional PIN only if TheTVDB issued a subscriber key. Baked in at build time.
EXPO_PUBLIC_TVDB_API_KEY=
EXPO_PUBLIC_TVDB_PIN=
EXPO_PUBLIC_INSTANT_APP_ID=your_instant_app_id_here
# Server-only. Instant dashboard → your app → Admin token. Never prefix with EXPO_PUBLIC_.
INSTANT_APP_ADMIN_TOKEN=your_instant_admin_token_here
